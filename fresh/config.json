{
  "version": 2,
  "theme": "terminal",
  "editor": {
    "enable_semantic_tokens_full": true,
    "use_terminal_bg": true,
    "screensaver_enabled": true,
    "indentation_guide": "all",
    "completion_popup_auto_show": true,
    "nerd_font_icons": true
  },
  "active_keybinding_map": "macos-gui",
  "default_language": "bash",
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    }
  }, 
  "keybindings": [
    {
      "key": "Enter",
      "action": "prompt_accept_suggestion",
      "when": "prompt"
    },
    {
      "comment": "Completion popup context - Enter accepts the selected completion",
      "key": "Enter",
      "action": "completion_accept",
      "when": "completion"
    },
    {
      "key": "g",
      "modifiers": ["ctrl"],
      "action": "goto_line",
      "when": "normal"
    },
    {
      "key": "Up",
      "modifiers": ["shift", "alt"],
      "action": "add_cursor_above",
      "when": "normal"
    },
    {
      "key": "Down",
      "modifiers": ["shift", "alt"],
      "action": "add_cursor_below",
      "when": "normal"
    }
  ],
  "file_explorer": {
    "show_hidden": false
  }
}
