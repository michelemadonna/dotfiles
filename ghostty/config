palette = 10=#c0e27c
palette = 11=#f8d96a
palette = 12=#49a3f7
palette = 13=#a47ce8
palette = 14=#98f9f2
palette = 15=#fefefe
background = #292c33
foreground = #fefbf6
cursor-color = #ea4030
cursor-text = #ea4030
selection-background = #133649
selection-foreground = #fefefe


